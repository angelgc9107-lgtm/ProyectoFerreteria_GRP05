@startuml actividad-flujo-1-busqueda-filtrado
title Flujo 1 - Búsqueda y filtrado del catálogo (RF4, RF5)
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam dpi 180
skinparam ArrowColor #444444
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #C0392B
skinparam SwimlaneBorderColor #7D7D7D

|Sistema|
start
:Carga el catálogo y renderiza los controles;
:Muestra inicialmente los productos;

repeat
  |Usuario|
  :Escribe en el buscador o cambia categoría,\norden o filtro de precio;
  :También puede enviar el formulario de búsqueda\no elegir una categoría del menú;

  |Sistema|
  :El evento input, change, click o submit\nlee los controles del DOM;
  :Envía texto, categoría, precio máximo opcional\ny orden a Catalogo.buscar();
  if (¿Los criterios son válidos?) then (sí)
    :Normaliza texto y categoría;
    :Filtra productos por criterios;
    :Ordena por precio ascendente o descendente;
    :Renderiza las tarjetas en el catálogo;
    if (¿Hay resultados?) then (sí)
      :Muestra la cantidad de productos encontrados\ncon el mensaje de estado del catálogo;
    else (no)
      :Muestra "Sin coincidencias"\nen el mensaje de estado;
    endif
  else (no)
    :Marca el control de precio como inválido;
    :Muestra el error en el campo y el estado del catálogo;
  endif

  |Usuario|
  :Revisa los resultados y decide\nsi cambia los criterios;
repeat while (¿Desea modificar la búsqueda o los filtros?) is (sí) not (no)

|Sistema|
:Mantiene visibles los resultados actuales\ny la interfaz del catálogo;
stop
@enduml
