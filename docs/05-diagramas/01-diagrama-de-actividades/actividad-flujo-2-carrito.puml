
@startuml actividad-flujo-2-carrito
title Flujo 2 - Gestión del carrito de compras (RF9 a RF13, RF20)
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam dpi 180
skinparam ArrowColor #444444
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #C0392B
skinparam SwimlaneBorderColor #7D7D7D

|Sistema|
start
:Recupera el carrito guardado y renderiza\nproductos, cantidades, subtotales y total;

repeat
  |Usuario|
  :Agrega un producto, escribe o confirma una cantidad,\no elige "Eliminar" en el carrito;

  |Sistema|
  if (¿Es un evento input de cantidad?) then (sí)
    :Valida la cantidad sin modificar el carrito;
    if (¿La cantidad es válida?) then (sí)
      :Muestra el estado válido del campo;
    else (no)
      :Marca el campo inválido y muestra el error;
    endif
  else (no)
    :Procesa click de agregar/eliminar\no change de cantidad;
    :Invoca Carrito.agregar(), Carrito.eliminar()\no Carrito.cambiarCantidad(), según la acción;
    if (¿La operación es válida?) then (sí)
      :Recalcula cantidades, subtotales y total;
      :Intenta persistir el carrito\nmediante FachadaStorage.guardarCarrito();
      if (¿Se pudo guardar?) then (sí)
        :Conserva el estado actualizado;
      else (no)
        :Advierte que los cambios podrían\nperderse al recargar la página;
      endif
      if (¿Había pago o pedido pendiente?) then (sí)
        :Invalida el pago y el pedido pendiente;
        :Informa que deberá seleccionar el pago otra vez;
      else (no)
      endif
      :Renderiza los ítems, cantidades, subtotales\ny total del carrito;
    else (no)
      :Conserva el carrito sin cambios;
      :Muestra el error y marca la cantidad inválida\nsi corresponde;
    endif
  endif

  |Usuario|
repeat while (¿Realiza otra operación en el carrito?) is (sí) not (no)

|Usuario|
:Elige "Iniciar compra" o cierra el panel;
|Sistema|
if (¿Elige "Iniciar compra"?) then (sí)
  if (¿El carrito contiene productos?) then (sí)
    :Restablece los estados anteriores de pago y pedido;
    :Muestra la sección de pago y cierra el Offcanvas;
    :Al cerrarse el panel, desplaza la vista al pago;
    :Continúa en el Flujo 3 - Pago y cuotas;
  else (no)
    :Informa que no se puede comprar\ncon el carrito vacío;
  endif
else (no)
  :Cierra el panel y continúa\nla navegación por la tienda;
endif
stop
@enduml
